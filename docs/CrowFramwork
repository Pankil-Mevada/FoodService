#include "crow.h"

int main()
{
    // STEP 1: Create Crow application
    crow::SimpleApp app;

    // STEP 2: Define a ROUTE
    CROW_ROUTE(app, "/")
    ([]()
    {
        return "Hello World!";
    });

    // STEP 3: Run the server on port 8080
