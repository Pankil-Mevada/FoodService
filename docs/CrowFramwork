PART 5: URL Parameters & Query Strings
#include "crow.h"

int main()
{
    crow::SimpleApp app;

    // ─────────────────────────────────────────────────
    // URL PARAMETER  →  /vehicle/123
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/vehicle/<int>")
    ([](int vehicle_id)
    {
        crow::json::wvalue response;
        response["vehicle_id"] = vehicle_id;
        response["name"]       = "Toyota Camry";
        response["status"]     = "active";

        return crow::response(200, response);
    });

    // ─────────────────────────────────────────────────
    // STRING PARAMETER  →  /driver/john
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/driver/<string>")
    ([](std::string driver_name)
    {
        crow::json::wvalue response;
        response["driver"]  = driver_name;
        response["license"] = "ABC-1234";

        return crow::response(200, response);
    });

    // ─────────────────────────────────────────────────
    // MULTIPLE PARAMETERS  →  /fleet/5/vehicle/99
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/fleet/<int>/vehicle/<int>")
    ([](int fleet_id, int vehicle_id)
    {
        crow::json::wvalue response;
        response["fleet_id"]   = fleet_id;
        response["vehicle_id"] = vehicle_id;

        return crow::response(200, response);
    });

    // ─────────────────────────────────────────────────
    // QUERY STRING  →  /search?speed=60&city=Tokyo
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/search")
    ([](const crow::request& req)
    {
        // Get query parameters
        auto speed = req.url_params.get("speed");
        auto city  = req.url_params.get("city");

        crow::json::wvalue response;

        if (speed)
            response["speed"] = std::string(speed);
        if (city)
            response["city"] = std::string(city);

        return crow::response(200, response);
    });

    app.port(8080).run();
    return 0;
}

