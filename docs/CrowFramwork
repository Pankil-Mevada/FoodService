PART 8: WebSocket Support
#include "crow.h"

int main()
{
    crow::SimpleApp app;

    // ─────────────────────────────────────────────────
    // WEBSOCKET ROUTE
    // Real-time bidirectional communication!
    // ─────────────────────────────────────────────────
    CROW_WEBSOCKET_ROUTE(app, "/ws/vehicle")
    .onopen([](crow::websocket::connection& conn)
    {
        // Client connected!
        CROW_LOG_INFO << "Client connected!";
        conn.send_text("Welcome to V2X WebSocket!");
    })
    .onmessage([](crow::websocket::connection& conn,
                  const std::string& message,
                  bool is_binary)
    {
        // Message received from client!
        CROW_LOG_INFO << "Message: " << message;

        // Echo back with extra info
        conn.send_text("Received: " + message);
    })
    .onclose([](crow::websocket::connection& conn,
                const std::string& reason)
    {
        // Client disconnected!
        CROW_LOG_INFO << "Client disconnected: "
                      << reason;
    });

    // Regular HTTP route alongside WebSocket
    CROW_ROUTE(app, "/")
    ([]()
    {
        return "V2X Server Running!";
    });

    app.port(8080).run();
    return 0;
}

