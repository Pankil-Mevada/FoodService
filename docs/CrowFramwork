PART 7: Middleware
#include "crow.h"

// ─────────────────────────────────────────────────────
// CUSTOM MIDDLEWARE
// Runs BEFORE every request!
// ─────────────────────────────────────────────────────

struct AuthMiddleware
{
    struct context {};

    // Runs BEFORE route handler
    void before_handle(crow::request& req,
                       crow::response& res,
                       context& ctx)
    {
        // Check API key in header
        auto api_key = req.get_header_value("X-API-Key");

        if (api_key != "my-secret-key-123")
        {
            // Reject unauthorized request!
            res.code = 401;
            res.write("Unauthorized! Invalid API Key!");
            res.end();
        }
    }

    // Runs AFTER route handler
    void after_handle(crow::request& req,
                      crow::response& res,
                      context& ctx)
    {
        // Add headers to every response
        res.add_header("X-Powered-By", "Crow C++");
        res.add_header("X-Version",    "1.0.0");
    }
};

// ─────────────────────────────────────────────────────
// LOGGING MIDDLEWARE
// ─────────────────────────────────────────────────────
struct LogMiddleware
{
    struct context {};

    void before_handle(crow::request& req,
                       crow::response& res,
                       context& ctx)
    {
        CROW_LOG_INFO << "REQUEST: "
                      << req.method_string()
                      << " "
                      << req.url;
    }

    void after_handle(crow::request& req,
                      crow::response& res,
                      context& ctx)
    {
        CROW_LOG_INFO << "RESPONSE CODE: "
                      << res.code;
    }
};

int main()
{
    // App WITH middleware!
    crow::App<AuthMiddleware, LogMiddleware> app;

    CROW_ROUTE(app, "/secure/data")
    ([]()
    {
        crow::json::wvalue response;
        response["secret"] = "Top secret data!";
        return crow::response(200, response);
    });

    app.port(8080).run();
    return 0;
}

