PART 4: HTTP Methods (GET, POST, PUT, DELETE)
#include "crow.h"

int main()
{
    crow::SimpleApp app;

    // ─────────────────────────────────────────────────
    // GET REQUEST - Retrieve data
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/vehicle/speed")
    .methods(crow::HTTPMethod::GET)
    ([](const crow::request& req)
    {
        crow::json::wvalue response;
        response["speed"]  = 60;
        response["unit"]   = "km/h";
        response["status"] = "moving";

        return crow::response(200, response);
    });

    // ─────────────────────────────────────────────────
    // POST REQUEST - Send data
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/vehicle/config")
    .methods(crow::HTTPMethod::POST)
    ([](const crow::request& req)
    {
        // Parse incoming JSON
        auto body = crow::json::load(req.body);

        if (!body)
        {
            return crow::response(400, "Invalid JSON!");
        }

        // Read values from JSON
        std::string mode = body["mode"].s();
        int speed_limit  = body["speed_limit"].i();

        crow::json::wvalue response;
        response["message"]     = "Config updated!";
        response["mode"]        = mode;
        response["speed_limit"] = speed_limit;

        return crow::response(201, response);
    });

    // ─────────────────────────────────────────────────
    // PUT REQUEST - Update data
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/vehicle/status")
    .methods(crow::HTTPMethod::PUT)
    ([](const crow::request& req)
    {
        auto body = crow::json::load(req.body);

        crow::json::wvalue response;
        response["message"] = "Status updated!";
        response["updated"] = true;

        return crow::response(200, response);
    });

    // ─────────────────────────────────────────────────
    // DELETE REQUEST - Remove data
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/vehicle/log")
    .methods(crow::HTTPMethod::DELETE)
    ([](const crow::request& req)
    {
        crow::json::wvalue response;
        response["message"] = "Log deleted!";

        return crow::response(200, response);
    });

    app.port(8080).multithreaded().run();
    return 0;
}

