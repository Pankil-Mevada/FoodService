PART 6: JSON Handling
#include "crow.h"

int main()
{
    crow::SimpleApp app;

    // ─────────────────────────────────────────────────
    // SENDING JSON RESPONSE
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/vehicle/data")
    ([]()
    {
        // Create JSON object
        crow::json::wvalue data;

        // Simple values
        data["id"]      = 1;
        data["speed"]   = 60.5;
        data["active"]  = true;
        data["name"]    = "Toyota Camry";

        // Nested object
        data["location"]["lat"] = 35.6762;
        data["location"]["lon"] = 139.6503;
        data["location"]["city"] = "Tokyo";

        // Array
        data["alerts"][0] = "Low fuel";
        data["alerts"][1] = "Oil change due";
        data["alerts"][2] = "Tire pressure low";

        return crow::response(200, data);
    });

    // ─────────────────────────────────────────────────
    // RECEIVING AND PARSING JSON
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/vehicle/update")
    .methods(crow::HTTPMethod::POST)
    ([](const crow::request& req)
    {
        // Parse JSON from request body
        auto json = crow::json::load(req.body);

        // Validate JSON
        if (!json)
        {
            return crow::response(400, "Bad JSON!");
        }

        // Check if field exists and read it
        if (json.has("speed"))
        {
            double speed = json["speed"].d();
            CROW_LOG_INFO << "Speed: " << speed;
        }

        if (json.has("location"))
        {
            double lat = json["location"]["lat"].d();
            double lon = json["location"]["lon"].d();
            CROW_LOG_INFO << "Lat: " << lat
                          << " Lon: " << lon;
        }

        crow::json::wvalue response;
        response["status"]  = "received";
        response["success"] = true;

        return crow::response(200, response);
    });

    app.port(8080).run();
    return 0;
}

