// ─────────────────────────────────────────────────────
// REAL WORLD: TCU REST API SERVER
// Using Crow for vehicle data API
// ─────────────────────────────────────────────────────

#include "crow.h"
#include <map>
#include <string>

// Simulated vehicle data store
struct VehicleData
{
    double speed;
    double lat;
    double lon;
    std::string status;
    int fuel_level;
};

std::map<int, VehicleData> vehicles =
{
    {1, {60.5, 35.6762, 139.6503, "moving",  80}},
    {2, {0.0,  34.6937, 135.5023, "parked",  45}},
    {3, {90.0, 35.0116, 135.7681, "moving",  92}},
};

int main()
{
    crow::SimpleApp app;

    // ─────────────────────────────────────────────────
    // GET ALL VEHICLES
    // GET /api/vehicles
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/api/vehicles")
    .methods(crow::HTTPMethod::GET)
    ([]()
    {
        crow::json::wvalue response;
        int i = 0;

        for (auto& [id, data] : vehicles)
        {
            response["vehicles"][i]["id"]         = id;
            response["vehicles"][i]["speed"]      = data.speed;
            response["vehicles"][i]["status"]     = data.status;
            response["vehicles"][i]["fuel_level"] = data.fuel_level;
            i++;
        }

        response["total"] = (int)vehicles.size();
        return crow::response(200, response);
    });

    // ─────────────────────────────────────────────────
    // GET SPECIFIC VEHICLE
    // GET /api/vehicle/1
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/api/vehicle/<int>")
    .methods(crow::HTTPMethod::GET)
    ([](int id)
    {
        if (vehicles.find(id) == vehicles.end())
        {
            crow::json::wvalue err;
            err["error"] = "Vehicle not found!";
            return crow::response(404, err);
        }

        auto& data = vehicles[id];

        crow::json::wvalue response;
        response["id"]              = id;
        response["speed"]           = data.speed;
        response["location"]["lat"] = data.lat;
        response["location"]["lon"] = data.lon;
        response["status"]          = data.status;
        response["fuel_level"]      = data.fuel_level;

        return crow::response(200, response);
    });

    // ─────────────────────────────────────────────────
    // UPDATE VEHICLE SPEED
    // POST /api/vehicle/1/speed
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/api/vehicle/<int>/speed")
    .methods(crow::HTTPMethod::POST)
    ([](const crow::request& req, int id)
    {
        if (vehicles.find(id) == vehicles.end())
        {
            crow::json::wvalue err;
            err["error"] = "Vehicle not found!";
            return crow::response(404, err);
        }

        auto body = crow::json::load(req.body);
        if (!body || !body.has("speed"))
        {
            crow::json::wvalue err;
            err["error"] = "Speed field required!";
            return crow::response(400, err);
        }

        double new_speed     = body["speed"].d();
        vehicles[id].speed   = new_speed;

        crow::json::wvalue response;
        response["message"]   = "Speed updated!";
        response["vehicle_id"]= id;
        response["new_speed"] = new_speed;

        return crow::response(200, response);
    });

    // ─────────────────────────────────────────────────
    // HEALTH CHECK
    // GET /health
    // ─────────────────────────────────────────────────
    CROW_ROUTE(app, "/health")
    ([]()
    {
        crow::json::wvalue response;
        response["status"]  = "healthy";
        response["service"] = "TCU API Server";
        response["version"] = "1.0.0";
        return crow::response(200, response);
    });

    CROW_LOG_INFO << "TCU API Server starting on port 8080";

    app.port(8080)
       .multithreaded()
       .concurrency(4)
       .run();

    return 0;
}

